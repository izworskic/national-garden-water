{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {"api/*.js": {"maxDuration": 20}},
  "rewrites": [
    {"source": "/api/national-geocode", "destination": "https://national-outdoor-core.vercel.app/api/national-geocode"}
  ],
  "headers": [
    {"source": "/api/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]},
    {"source": "/(.*)", "has": [{"type": "host", "value": "(?<preview>.*)\\.vercel\\.app"}], "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]}
  ]
}
